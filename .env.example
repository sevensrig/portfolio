# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Public base URL of the media bucket (no trailing slash). Also set this in
# Vercel → Project → Settings → Environment Variables, then redeploy.
PUBLIC_MEDIA_BASE=

# S3-compatible storage used by `npm run media` to upload. Works with
# Cloudflare R2 or Akamai (Linode) Object Storage.
#   R2:     endpoint https://<account-id>.r2.cloudflarestorage.com, region auto
#   Akamai: endpoint https://<region>.linodeobjects.com, region = that region
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=auto
MEDIA_S3_BUCKET=portfolio-media
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=

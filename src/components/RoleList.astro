---
// A scannable list of roles (Experience; Leadership and community). Each row
// opens (native <details>, so it's keyboard- and screen-reader-friendly with no
// script) to show a line of context, bullets and an optional link, all from
// src/data/resume.yaml. Anything after the list goes in the default slot.
import { termYears } from "../lib/format"

interface Job {
  company: string
  role: string
  start: Date
  end: Date | null
  returned?: { start: Date; end: Date | null }[]
  summary?: string
  bullets: string[]
  link?: { label: string; href: string }
}
interface Props {
  id: string
  title: string
  roles: Job[]
}
const { id, title, roles } = Astro.props
---

<section id={id} class="pb-32">
  <h2 class="font-mono text-xs uppercase tracking-widest text-base-content/60 mb-6">{title}</h2>
  <ol class="border-t border-base-content">
    {roles.map((job) => (
      <li class="border-b border-base-content/15">
        <details class="job group">
          <summary class="relative grid md:grid-cols-[1fr_2fr_6rem_1.5rem] gap-1 md:gap-8 py-6 pr-10 md:pr-0 cursor-pointer list-none">
            <span class="font-semibold">{job.company}</span>
            <span class="text-base-content/70">{job.role}</span>
            <span class="font-mono text-xs text-base-content/60 md:pt-1 md:text-right">{termYears([job, ...(job.returned ?? [])])}</span>
            <span class="job-toggle absolute right-0 top-5 md:static md:-mt-0.5 size-6 grid place-items-center border border-base-content/25 text-base-content/60 transition-colors group-hover:border-base-content group-hover:text-base-content" aria-hidden="true">
              <svg class="size-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1.5 6h9" /><path class="plus-v" d="M6 1.5v9" /></svg>
            </span>
          </summary>
          <div class="grid md:grid-cols-[1fr_2fr_6rem_1.5rem] md:gap-8 pb-8 -mt-2">
            <div class="md:col-start-2 md:col-span-2 max-w-2xl">
              {job.summary && <p class="text-base-content/70">{job.summary}</p>}
              <ul class:list={["space-y-2 leading-relaxed", job.summary && "mt-4"]}>
                {job.bullets.map((b) => (
                  <li class="relative pl-5 before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2.5 before:bg-base-content/40">{b}</li>
                ))}
              </ul>
              {job.link && (
                <a href={job.link.href} target="_blank" rel="noopener" class="mt-4 inline-block font-medium underline decoration-primary decoration-2 underline-offset-4">
                  {job.link.label} ↗
                </a>
              )}
            </div>
          </div>
        </details>
      </li>
    ))}
  </ol>
  <slot />
</section>

<style>
  summary::-webkit-details-marker { display: none; }
  /* + becomes − when the row is open: the vertical stroke folds away. */
  .plus-v { transform-box: fill-box; transform-origin: center; transition: transform .2s ease; }
  details[open] .plus-v { transform: scaleY(0); }
  details[open] .job-toggle { border-color: var(--color-base-content); color: var(--color-base-content); }
  @media (prefers-reduced-motion: reduce) { .plus-v { transition: none; } }
  summary:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 4px; }
</style>

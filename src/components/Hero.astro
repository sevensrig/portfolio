---
import ShaderBackground from "./ShaderBackground.astro"

interface Props {
  github: string
  linkedin: string
}
const { github, linkedin } = Astro.props
---

<section class="relative overflow-hidden border-y border-base-content/10">
  <ShaderBackground class="absolute inset-0" />
  <div class="relative px-4 md:px-12 max-w-6xl mx-auto min-h-[calc(100svh-5rem)] py-24 flex flex-col items-center justify-center text-center">
    <h1 class="font-semibold leading-[0.98] tracking-[-0.04em] text-[clamp(2.6rem,7vw,6.5rem)] text-balance">
      Shipping web&nbsp;apps, AI&nbsp;agents, and the occasional Raspberry&nbsp;Pi&nbsp;hack<span class="text-primary">.</span>
    </h1>
    <p class="mt-10 mx-auto max-w-xl text-lg md:text-xl leading-relaxed text-base-content/70">
      CS at Northeastern, graduating May 2027. Previously at SimpliSafe, Fenwick &amp; West, and Northeastern ITS.
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-5 font-medium">
      <div class="flex items-center gap-3">
        <a href="#work" class="btn btn-primary font-semibold">See the work</a>
        <a href="#experience" class="btn bg-white border-transparent font-semibold hover:bg-base-200">Experience</a>
      </div>
      <div class="flex items-center gap-6">
        <a href={github} class="hover:text-primary" target="_blank" rel="me noopener">GitHub ↗</a>
        <a href={linkedin} class="hover:text-primary" target="_blank" rel="me noopener">LinkedIn ↗</a>
      </div>
    </div>
  </div>
</section>

---
// SimpliSync: a Next.js app between a Zoom transcript, a local LLM and Jira.
---

<svg class="dg" viewBox="0 0 960 320" role="img" aria-labelledby="ss-title ss-desc">
  <title id="ss-title">SimpliSync architecture</title>
  <desc id="ss-desc">A user pastes a Zoom transcript into a Next.js app. Its parse route sends the transcript to a locally running LLM through Ollama, which returns structured ticket updates. Those updates feed the post route: after the user reviews and approves them, it posts comments, issue links and subtasks to Jira Cloud.</desc>
  <defs>
    <marker id="ss-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--color-base-content)" />
    </marker>
  </defs>

  <!-- User -->
  <rect class="dg-box" x="20" y="96" width="170" height="108" />
  <text class="dg-kicker" x="36" y="122">USER</text>
  <text class="dg-name" x="36" y="146">Pastes a transcript</text>
  <text class="dg-note" x="36" y="168">reviews, then accepts</text>
  <text class="dg-note" x="36" y="188">or rejects each update</text>
  <line class="dg-line" x1="190" y1="150" x2="248" y2="150" marker-end="url(#ss-arrow)" />
  <circle class="dg-dot" cx="190" cy="150" r="3.5" />

  <!-- Next.js app -->
  <rect class="dg-box" x="250" y="20" width="400" height="260" />
  <text class="dg-kicker" x="270" y="46">NEXT.JS APP · TYPESCRIPT</text>
  <rect class="dg-inner" x="270" y="62" width="360" height="56" />
  <text class="dg-name" x="284" y="86">React UI</text>
  <text class="dg-note" x="284" y="106">paste → review → swipe to confirm → results</text>
  <rect class="dg-inner" x="270" y="138" width="360" height="56" />
  <text class="dg-name" x="284" y="162">/api/parse</text>
  <text class="dg-note" x="284" y="182">transcript → structured ticket updates</text>
  <rect class="dg-inner" x="270" y="214" width="360" height="56" />
  <text class="dg-name" x="284" y="238">/api/post-comments</text>
  <text class="dg-note" x="284" y="258">applies only the approved updates</text>

  <!-- Routes → services -->
  <path class="dg-line" d="M630 166 H700 V100 H738" marker-end="url(#ss-arrow)" />
  <circle class="dg-dot" cx="630" cy="166" r="3.5" />
  <path class="dg-line" d="M630 242 H700 V214 H738" marker-end="url(#ss-arrow)" />
  <circle class="dg-dot" cx="630" cy="242" r="3.5" />

  <rect class="dg-box" x="740" y="56" width="200" height="88" />
  <text class="dg-kicker" x="756" y="80">OLLAMA · ON THE LAPTOP</text>
  <text class="dg-name" x="756" y="104">Local LLM</text>
  <text class="dg-note" x="756" y="124">transcript never leaves</text>

  <!-- LLM output comes back around to the post route -->
  <path class="dg-line" d="M940 100 H952 V304 H450 V271" marker-end="url(#ss-arrow)" />
  <circle class="dg-dot" cx="940" cy="100" r="3.5" />
  <text class="dg-edge" x="700" y="298" text-anchor="middle">STRUCTURED UPDATES</text>

  <rect class="dg-cloud" x="740" y="170" width="200" height="88" />
  <text class="dg-kicker" x="756" y="194">JIRA CLOUD · REST API</text>
  <text class="dg-name" x="756" y="218">Ticket updates</text>
  <text class="dg-note" x="756" y="238">comments, links, subtasks</text>
</svg>

---
// TV Ambilight: the Mac mirrors to the TV, captures its own screen, and
// drives three lights over their local UDP protocols.
const steps = [
  { name: "Capture the screen", note: "mss · ~20 ms · shrink to ~190 px wide" },
  { name: "Crop black bars", note: "letterbox and pillarbox" },
  { name: "Dominant color × 3 regions", note: "24-bin hue histogram, not an average" },
  { name: "Smooth", note: "moving average · snaps on scene cuts" },
]
const top = 96
const gap = 68
const lights = [
  { y: 52, kicker: "LIFX BULB", name: "Top-left of screen", note: "UDP 56700 · binary" },
  { y: 160, kicker: "LIFX BULB", name: "Bottom-left of screen", note: "UDP 56700 · binary" },
  { y: 268, kicker: "GOVEE LIGHT", name: "Right of screen", note: "UDP 4003 · JSON · ≤ 5/s" },
]
---

<svg class="dg" viewBox="0 0 960 380" role="img" aria-labelledby="amb-title amb-desc">
  <title id="amb-title">TV Ambilight architecture</title>
  <desc id="amb-desc">A Mac mirrors its display to the TV. Twelve times a second, a Python script captures the screen, crops black bars, picks the dominant color of three regions, smooths it, and sends it over UDP to two LIFX bulbs and a Govee light on the local network.</desc>
  <defs>
    <marker id="amb-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--color-base-content)" />
    </marker>
  </defs>

  <!-- TV -->
  <rect class="dg-box" x="20" y="140" width="150" height="96" />
  <text class="dg-kicker" x="36" y="166">TV</text>
  <text class="dg-name" x="36" y="190">Mirrored display</text>
  <text class="dg-note" x="36" y="212">shows the Mac</text>

  <line class="dg-line" x1="248" y1="188" x2="172" y2="188" marker-end="url(#amb-arrow)" />
  <text class="dg-edge" x="210" y="178" text-anchor="middle">AIRPLAY</text>
  <text class="dg-edge" x="210" y="206" text-anchor="middle">/ HDMI</text>

  <!-- Mac pipeline -->
  <rect class="dg-box" x="250" y="20" width="420" height="340" />
  <text class="dg-kicker" x="270" y="46">MAC · PYTHON</text>
  <text class="dg-title" x="270" y="74">ambilight.py · 12 fps</text>
  {steps.map((s, i) => (
    <>
      <rect class="dg-inner" x="270" y={top + i * gap} width="380" height="52" />
      <text class="dg-kicker" x="284" y={top + i * gap + 22} style="fill-opacity:.9">{`0${i + 1}`}</text>
      <text class="dg-name" x="312" y={top + i * gap + 22}>{s.name}</text>
      <text class="dg-note" x="312" y={top + i * gap + 41}>{s.note}</text>
      {i < steps.length - 1 && (
        <line class="dg-line" x1="460" y1={top + i * gap + 52} x2="460" y2={top + (i + 1) * gap - 2} marker-end="url(#amb-arrow)" />
      )}
    </>
  ))}

  <!-- Smooth → lights -->
  {lights.map((l) => (
    <path class="dg-line" d={`M650 ${top + 3 * gap + 26} H700 V${l.y + 36} H738`} marker-end="url(#amb-arrow)" />
  ))}
  <circle class="dg-dot" cx="650" cy={top + 3 * gap + 26} r="3.5" />
  <text class="dg-edge" x="740" y="38">LOCAL WIFI · NO CLOUD</text>
  {lights.map((l) => (
    <>
      <rect class="dg-box" x="740" y={l.y} width="200" height="76" />
      <text class="dg-kicker" x="756" y={l.y + 22}>{l.kicker}</text>
      <text class="dg-name" x="756" y={l.y + 44}>{l.name}</text>
      <text class="dg-note" x="756" y={l.y + 64}>{l.note}</text>
    </>
  ))}
</svg>

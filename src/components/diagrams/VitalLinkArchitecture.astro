---
// VitalLink: bedside devices → a Health Twin per ward → PCT dashboard, with a
// central coordinator for federated learning and network priority.
const wards = [
  { y: 66, name: "ICU" },
  { y: 160, name: "General ward" },
  { y: 254, name: "Step-down" },
]
---

<svg class="dg" viewBox="0 0 960 380" role="img" aria-labelledby="vl-title vl-desc">
  <title id="vl-title">VitalLink architecture</title>
  <desc id="vl-desc">Existing bedside monitors stream vitals to an edge Health Twin in each ward, which detects deterioration and raises alerts locally on the PCT dashboard. Each Health Twin sends only model updates to a central on-prem coordinator, which averages them with federated learning and allocates network priority over private 5G slices managed through Verizon ThingSpace.</desc>
  <defs>
    <marker id="vl-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--color-base-content)" />
    </marker>
  </defs>

  <!-- Bedside -->
  <rect class="dg-box" x="20" y="146" width="150" height="96" />
  <text class="dg-kicker" x="36" y="172">BEDSIDE</text>
  <text class="dg-name" x="36" y="196">Existing monitors</text>
  <text class="dg-note" x="36" y="218">continuous vitals</text>
  <line class="dg-line" x1="170" y1="194" x2="218" y2="194" marker-end="url(#vl-arrow)" />
  <circle class="dg-dot" cx="170" cy="194" r="3.5" />

  <!-- Health Twins, one per ward -->
  <rect class="dg-box" x="220" y="20" width="300" height="340" />
  <text class="dg-kicker" x="240" y="46">HEALTH TWIN · ONE PER WARD</text>
  {wards.map((w) => (
    <>
      <rect class="dg-inner" x="240" y={w.y} width="260" height="78" />
      <text class="dg-name" x="254" y={w.y + 28}>{w.name}</text>
      <text class="dg-note" x="254" y={w.y + 52}>edge mini-PC: detects, forecasts,</text>
      <text class="dg-note" x="254" y={w.y + 68}>and alerts without the cloud</text>
    </>
  ))}

  <!-- Twins → dashboard, twins → coordinator -->
  <line class="dg-line" x1="520" y1="86" x2="578" y2="86" marker-end="url(#vl-arrow)" />
  <circle class="dg-dot" cx="520" cy="86" r="3.5" />
  <text class="dg-edge" x="549" y="74" text-anchor="middle">ALERTS</text>
  <line class="dg-line" x1="520" y1="300" x2="578" y2="300" marker-end="url(#vl-arrow)" />
  <circle class="dg-dot" cx="520" cy="300" r="3.5" />
  <text class="dg-edge" x="549" y="288" text-anchor="middle">UPDATES</text>
  <text class="dg-edge" x="549" y="324" text-anchor="middle">ONLY</text>

  <rect class="dg-box" x="580" y="40" width="180" height="92" />
  <text class="dg-kicker" x="596" y="64">CLINICIANS</text>
  <text class="dg-name" x="596" y="88">PCT dashboard</text>
  <text class="dg-note" x="596" y="110">alert queue, escalation</text>

  <rect class="dg-box" x="580" y="248" width="180" height="104" />
  <text class="dg-kicker" x="596" y="272">ON-PREM</text>
  <text class="dg-name" x="596" y="296">Central coordinator</text>
  <text class="dg-note" x="596" y="318">federated averaging</text>
  <text class="dg-note" x="596" y="338">bandwidth priority</text>

  <!-- Network -->
  <line class="dg-line" x1="762" y1="300" x2="788" y2="300" marker-start="url(#vl-arrow)" marker-end="url(#vl-arrow)" />
  <rect class="dg-cloud" x="790" y="40" width="150" height="312" />
  <text class="dg-kicker" x="806" y="64">VERIZON</text>
  <text class="dg-name" x="806" y="88">Private 5G</text>
  <text class="dg-note" x="806" y="108">via ThingSpace</text>
  <rect class="dg-inner" x="806" y="130" width="118" height="56" />
  <text class="dg-name" x="818" y="154">Critical care</text>
  <text class="dg-note" x="818" y="174">slice</text>
  <rect class="dg-inner" x="806" y="198" width="118" height="56" />
  <text class="dg-note" x="818" y="222">Routine</text>
  <text class="dg-note" x="818" y="242">monitoring</text>
  <rect class="dg-inner" x="806" y="266" width="118" height="56" />
  <text class="dg-note" x="818" y="290">Admin</text>
  <text class="dg-note" x="818" y="310">traffic</text>
</svg>

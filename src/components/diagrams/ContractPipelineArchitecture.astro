---
// Legal AI: the contract-intelligence pipeline. Contracts come out of iManage,
// get parsed and rule-extracted on Databricks, a hosted Claude endpoint writes
// the briefing, and everything lands as query-ready tables.
const steps = [
  { name: "Parse in memory", note: "DOCX and PDF · tables kept · signed vs template" },
  { name: "Read metadata", note: "document ID, client, matter, workspace" },
  { name: "Extract terms with rules", note: "type, counterparty, dates, renewal, pricing model" },
  { name: "Write a briefing", note: "summary, obligations, critical dates" },
  { name: "Land as tables", note: "query-ready in Databricks" },
]
const top = 92
const gap = 60
const y = (i: number) => top + i * gap
---

<svg class="dg" viewBox="0 0 960 420" role="img" aria-labelledby="cp-title cp-desc">
  <title id="cp-title">Contract intelligence pipeline</title>
  <desc id="cp-desc">Contracts are pulled from the iManage document system over its REST API with OAuth. On Databricks, a Python pipeline parses DOCX and PDF files in memory, reads iManage metadata, extracts contract terms with deterministic rules, sends each document to a Claude model on Databricks model serving for a briefing, and writes the results to query-ready tables. Credentials live in Databricks secret scopes.</desc>
  <defs>
    <marker id="cp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--color-base-content)" />
    </marker>
  </defs>

  <!-- iManage -->
  <rect class="dg-cloud" x="20" y="68" width="150" height="96" />
  <text class="dg-kicker" x="36" y="92">IMANAGE DMS</text>
  <text class="dg-name" x="36" y="116">Contracts</text>
  <text class="dg-note" x="36" y="138">REST API</text>

  <!-- Databricks pipeline -->
  <rect class="dg-box" x="250" y="20" width="480" height="380" />
  <text class="dg-kicker" x="270" y="46">DATABRICKS · PYTHON · SECRETS IN SCOPES</text>
  <text class="dg-title" x="270" y="74">Contract pipeline</text>
  {steps.map((s, i) => (
    <>
      <rect class="dg-inner" x="270" y={y(i)} width="440" height="48" />
      <text class="dg-kicker" x="284" y={y(i) + 20} style="fill-opacity:.9">{`0${i + 1}`}</text>
      <text class="dg-name" x="312" y={y(i) + 20}>{s.name}</text>
      <text class="dg-note" x="312" y={y(i) + 38}>{s.note}</text>
      {i < steps.length - 1 && (
        <line class="dg-line" x1="490" y1={y(i) + 48} x2="490" y2={y(i + 1) - 2} marker-end="url(#cp-arrow)" />
      )}
    </>
  ))}

  <!-- iManage → pipeline (drawn after the box so its fill doesn't cover the arrow) -->
  <line class="dg-line" x1="170" y1={y(0) + 24} x2="268" y2={y(0) + 24} marker-end="url(#cp-arrow)" />
  <circle class="dg-dot" cx="170" cy={y(0) + 24} r="3.5" />
  <text class="dg-edge" x="210" y={y(0) + 14} text-anchor="middle">OAUTH</text>

  <!-- Hosted model -->
  <line class="dg-line" x1="712" y1={y(3) + 24} x2="768" y2={y(3) + 24} marker-start="url(#cp-arrow)" marker-end="url(#cp-arrow)" />
  <rect class="dg-box" x="770" y={y(3) - 16} width="170" height="80" />
  <text class="dg-kicker" x="786" y={y(3) + 6}>MODEL SERVING</text>
  <text class="dg-name" x="786" y={y(3) + 30}>Claude endpoint</text>
  <text class="dg-note" x="786" y={y(3) + 50}>real-time inference</text>

</svg>

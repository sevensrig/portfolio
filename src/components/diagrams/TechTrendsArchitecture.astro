---
// Tech Trends News Agent: NewsAPI → NLTK → TF-IDF, then a chat path (local
// LLM over the top articles) and a topics path (co-occurrence clusters).
---

<svg class="dg" viewBox="0 0 960 300" role="img" aria-labelledby="tt-title tt-desc">
  <title id="tt-title">Tech Trends News Agent pipeline</title>
  <desc id="tt-desc">Technology headlines from NewsAPI are tokenized and lemmatized with NLTK and indexed with a TF-IDF search written from scratch. Questions retrieve the top five articles, which a local Qwen2.5-1.5B model turns into an answer with sources. Separately, term co-occurrence clusters the corpus into five topics with sub-trends. A Streamlit app shows both.</desc>
  <defs>
    <marker id="tt-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--color-base-content)" />
    </marker>
  </defs>

  <rect class="dg-cloud" x="20" y="105" width="150" height="90" />
  <text class="dg-kicker" x="36" y="129">NEWSAPI</text>
  <text class="dg-name" x="36" y="153">Tech headlines</text>
  <text class="dg-note" x="36" y="175">~70–100 per fetch</text>

  <line class="dg-line" x1="170" y1="150" x2="198" y2="150" marker-end="url(#tt-arrow)" />
  <circle class="dg-dot" cx="170" cy="150" r="3.5" />
  <rect class="dg-box" x="200" y="105" width="160" height="90" />
  <text class="dg-kicker" x="216" y="129">NLTK</text>
  <text class="dg-name" x="216" y="153">Preprocess</text>
  <text class="dg-note" x="216" y="175">tokenize, lemmatize</text>

  <line class="dg-line" x1="360" y1="150" x2="388" y2="150" marker-end="url(#tt-arrow)" />
  <circle class="dg-dot" cx="360" cy="150" r="3.5" />
  <rect class="dg-box" x="390" y="105" width="170" height="90" />
  <text class="dg-kicker" x="406" y="129">FROM SCRATCH</text>
  <text class="dg-name" x="406" y="153">TF-IDF index</text>
  <text class="dg-note" x="406" y="175">titles weighted 3×</text>

  <path class="dg-line" d="M560 150 H580 V85 H598" marker-end="url(#tt-arrow)" />
  <path class="dg-line" d="M560 150 H580 V225 H598" marker-end="url(#tt-arrow)" />
  <circle class="dg-dot" cx="560" cy="150" r="3.5" />

  <rect class="dg-box" x="600" y="40" width="190" height="90" />
  <text class="dg-kicker" x="616" y="64">CHAT · COLAB T4</text>
  <text class="dg-name" x="616" y="88">Qwen2.5-1.5B</text>
  <text class="dg-note" x="616" y="110">answers from top 5</text>

  <rect class="dg-box" x="600" y="180" width="190" height="90" />
  <text class="dg-kicker" x="616" y="204">TOPICS</text>
  <text class="dg-name" x="616" y="228">Co-occurrence</text>
  <text class="dg-note" x="616" y="250">5 topics × 5 sub-trends</text>

  <line class="dg-line" x1="790" y1="85" x2="818" y2="85" marker-end="url(#tt-arrow)" />
  <line class="dg-line" x1="790" y1="225" x2="818" y2="225" marker-end="url(#tt-arrow)" />
  <rect class="dg-box" x="820" y="40" width="120" height="230" />
  <text class="dg-kicker" x="836" y="64">STREAMLIT</text>
  <text class="dg-name" x="836" y="88">The app</text>
  <text class="dg-note" x="836" y="118">answers</text>

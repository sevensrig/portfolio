---
// "Contact me." with a headshot beside it (above it on phones), so the person
// you're about to email has a face.
import { Image } from "astro:assets"
import headshot from "../assets/headshot.jpg"
import Icon from "./Icon.astro"
import { faEnvelope } from "@fortawesome/free-regular-svg-icons"

interface Props {
  email: string
  name: string
}
const { email, name } = Astro.props
---

<section id="contact" class="pb-28 flex flex-col md:flex-row md:items-end gap-8 md:gap-12">
  <Image
    src={headshot}
    alt={name}
    widths={[240, 360, 480]}
    sizes="(min-width: 768px) 240px, 160px"
    class="w-40 md:w-60 aspect-[4/5] object-cover border border-base-content/20"
  />
  <div>
    <h2 class="font-semibold tracking-[-0.04em] leading-[0.95] text-[clamp(2.4rem,6vw,5rem)]">Contact me<span class="text-primary">.</span></h2>
    <a href={`mailto:${email}`} class="mt-6 inline-flex items-center gap-3 text-xl md:text-2xl font-medium hover:text-primary"><Icon icon={faEnvelope} class="text-[0.8em]" /><span class="underline decoration-primary decoration-2 underline-offset-[6px]">{email}</span></a>
  </div>
</section>

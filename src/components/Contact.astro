---
interface Props {
  email: string
}
const { email } = Astro.props
---

<section id="contact" class="pb-28">
  <h2 class="font-semibold tracking-[-0.04em] leading-[0.95] text-[clamp(2.4rem,6vw,5rem)]">Let's talk<span class="text-primary">.</span></h2>
  <a href={`mailto:${email}`} class="mt-6 inline-block text-xl md:text-2xl font-medium underline decoration-primary decoration-2 underline-offset-[6px] hover:text-primary">{email}</a>
</section>

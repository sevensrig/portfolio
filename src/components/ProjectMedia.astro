---
// A project's cover image, or a neutral placeholder until it has one.
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

interface Props {
  src?: ImageMetadata
  alt: string
  aspect: "wide" | "card"
  /** CSS object-position for the crop, e.g. "center 75%". */
  position?: string
  class?: string
  /** Shared name for the page transition between a card and its project page. */
  transitionName?: string
  /** The page's main image (a project header): load it right away, not lazily. */
  priority?: boolean
}
const { src, alt, aspect, position, class: className, transitionName, priority = false } = Astro.props
// Cards sit two to a row from md up, so they never need the full-width files.
const sizes = aspect === "card" ? "(min-width: 1152px) 560px, (min-width: 768px) 50vw, 100vw" : "(min-width: 1152px) 1152px, 100vw"
const ratio = aspect === "wide" ? "aspect-[16/9]" : "aspect-[4/3]"
---

<div
  class:list={["project-media overflow-hidden border border-base-content/20", ratio, className]}
  style={transitionName ? `view-transition-name: ${transitionName}; view-transition-class: project-media` : undefined}
>
  {
    src ? (
      <Image src={src} alt={alt} class="size-full object-cover" style={position ? `object-position: ${position}` : undefined} widths={[640, 960, 1280, 1920]} {sizes} loading={priority ? "eager" : "lazy"} fetchpriority={priority ? "high" : "auto"} />
    ) : (
      <div class="size-full bg-linear-160 from-[#e2ddcf] to-[#cbc5b4]" role="img" aria-label={`${alt} (image coming soon)`} />
    )
  }
</div>

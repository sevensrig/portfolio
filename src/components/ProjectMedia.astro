---
// A project's cover image, or a neutral placeholder until it has one.
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

interface Props {
  src?: ImageMetadata
  alt: string
  aspect: "wide" | "card"
  class?: string
}
const { src, alt, aspect, class: className } = Astro.props
const ratio = aspect === "wide" ? "aspect-[16/9]" : "aspect-[4/3]"
---

<div class:list={["project-media overflow-hidden border border-base-content/20", ratio, className]}>
  {
    src ? (
      <Image src={src} alt={alt} class="size-full object-cover" widths={[640, 960, 1280, 1920]} sizes="(min-width: 1152px) 1152px, 100vw" />
    ) : (
      <div class="size-full bg-linear-160 from-[#e2ddcf] to-[#cbc5b4]" role="img" aria-label={`${alt} (image coming soon)`} />
    )
  }
</div>

---
import type { CollectionEntry } from "astro:content"
import ProjectMedia from "./ProjectMedia.astro"
import { yearRange } from "../lib/format"

interface Props {
  project: CollectionEntry<"projects">
  /** The large first project: wide media with a two-column caption. */
  featured?: boolean
  class?: string
}
const { project, featured = false, class: className } = Astro.props
const { title, summary, stack, period, categories, media } = project.data
const href = `/projects/${project.id}/`
const meta = [yearRange(period.start, period.end), ...stack.slice(0, 3)].join(" · ")
---

{
  featured ? (
    <a href={href} class:list={["group block", className]} data-categories={categories.join(" ")}>
      <ProjectMedia src={media.hero} alt={title} aspect="wide" />
      <div class="mt-8 grid md:grid-cols-2 gap-6 md:gap-12">
        <div>
          <h3 class="text-3xl md:text-4xl font-semibold tracking-[-0.035em]">{title}</h3>
          <p class="mt-2 font-mono text-xs text-base-content/50">{meta}</p>
        </div>
        <p class="text-lg leading-relaxed text-base-content/75">
          {summary}{" "}
          <span class="text-base-content font-medium underline decoration-primary decoration-2 underline-offset-4">Read the story →</span>
        </p>
      </div>
    </a>
  ) : (
    <a href={href} class:list={["group block", className]} data-categories={categories.join(" ")}>
      <ProjectMedia src={media.hero} alt={title} aspect="card" />
      <h3 class="mt-6 text-2xl font-semibold tracking-[-0.03em]">{title}</h3>
      <p class="mt-2 text-base-content/70">{summary}</p>
      <p class="mt-3 font-mono text-xs text-base-content/50">{meta}</p>
    </a>
  )
}

<style>
  /* Media dims slightly on hover; no lift or shadow (see docs/PLAN.md). */
  a :global(.project-media) { transition: opacity 0.2s; }
  a:hover :global(.project-media) { opacity: 0.85; }
</style>

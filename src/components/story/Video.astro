---
// A video from the media bucket. `loop` plays muted and silently on repeat,
// like a GIF; otherwise it gets normal controls.
//
// `src` is "r2:<slug>/<name>" as printed by `npm run media`: WebM is offered
// first (smaller), MP4 as the fallback. A src with an extension is used as is.
// Falls back to the poster if PUBLIC_MEDIA_BASE isn't configured.
import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"
import { mediaUrl } from "../../lib/media"

interface Props {
  src: string
  poster: ImageMetadata
  caption?: string
  loop?: boolean
  wide?: boolean
  /** Tall phone clips: keep them narrow and centered. */
  portrait?: boolean
  class?: string
  /** Shared name for the page transition from the project's card. */
  transitionName?: string
}
const { src, poster, caption, loop = false, wide = false, portrait = false, class: className, transitionName } = Astro.props
const vtStyle = transitionName ? `view-transition-name: ${transitionName}; view-transition-class: project-media` : undefined
const hasExt = /\.[a-z0-9]+$/i.test(src)
const sources = (hasExt ? [src] : [`${src}.webm`, `${src}.mp4`])
  .map((s) => ({ url: mediaUrl(s), type: s.endsWith(".webm") ? "video/webm" : "video/mp4" }))
  .filter((s): s is { url: string; type: string } => !!s.url)
const posterUrl = (await getImage({ src: poster, width: Math.min(1440, poster.width) })).src
const box = "w-full border border-base-content/20"
const playback = loop
  ? { autoplay: true, muted: true, loop: true, playsinline: true }
  : { controls: true, playsinline: true }
---

<figure class:list={[className ?? "my-12", wide && "md:-mx-24 lg:-mx-40", portrait && "mx-auto max-w-sm"]}>
  {
    sources.length ? (
      <video class={box} style={vtStyle} poster={posterUrl} preload="metadata" {...playback}>
        {sources.map((s) => <source src={s.url} type={s.type} />)}
      </video>
    ) : (
      <img class={box} style={vtStyle} src={posterUrl} alt={caption ?? ""} />
    )
  }
  {caption && <figcaption class="mt-3 font-mono text-xs text-base-content/50">{caption}</figcaption>}
</figure>

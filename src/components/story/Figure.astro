---
// One image with a caption. `wide` lets it break out of the text column.
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

interface Props {
  src: ImageMetadata
  alt: string
  caption?: string
  wide?: boolean
}
const { src, alt, caption, wide = false } = Astro.props
---

<figure class:list={["my-12", wide && "md:-mx-24 lg:-mx-40"]}>
  <Image src={src} alt={alt} class="w-full border border-base-content/20" widths={[640, 960, 1440]} sizes="(min-width: 1024px) 1000px, 100vw" />
  {caption && <figcaption class="mt-3 font-mono text-xs text-base-content/50">{caption}</figcaption>}
</figure>

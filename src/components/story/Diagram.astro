---
// Frames an inline SVG diagram: wider than the text column, scrolls sideways
// on narrow phones instead of shrinking the labels to nothing.
interface Props {
  caption?: string
}
const { caption } = Astro.props
---

<figure class="my-12 md:-mx-24 lg:-mx-40">
  <div class="overflow-x-auto border border-base-content/20 bg-base-100">
    <div class="min-w-[720px] p-4 md:p-6"><slot /></div>
  </div>
  {caption && <figcaption class="mt-3 font-mono text-xs text-base-content/50">{caption}</figcaption>}
</figure>

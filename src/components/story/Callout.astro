---
import Icon from "../Icon.astro"
import { faBug } from "@fortawesome/free-solid-svg-icons"
// A boxed aside in a project story. "broke" is for failure stories, which
// recruiters tend to remember more than the happy path.
interface Props {
  type?: "broke" | "lesson" | "note"
  title?: string
}
const labels = { broke: "What broke", lesson: "Lesson", note: "Note" }
const { type = "note", title } = Astro.props
---

<aside class:list={["callout not-prose my-10 border p-6", type === "broke" ? "border-base-content bg-white" : "border-base-content/20"]}>
  <p class="font-mono text-xs uppercase tracking-widest text-base-content/60">
    {type === "broke" && <Icon icon={faBug} class="mr-2 text-primary" />}{labels[type]}{title && <span class="text-base-content"> · {title}</span>}
  </p>
  <div class="mt-3 text-base leading-relaxed [&>*+*]:mt-3"><slot /></div>
</aside>

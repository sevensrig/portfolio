---
// Dated milestones, e.g. from the project's git history.
interface Props {
  items: { date: string; text: string }[]
}
const { items } = Astro.props
---

<ol class="not-prose my-10 border-t border-base-content/15">
  {items.map((item) => (
    <li class="grid grid-cols-[6.5rem_1fr] gap-4 py-4 border-b border-base-content/15">
      <span class="font-mono text-xs text-base-content/50 pt-1">{item.date}</span>
      <span class="leading-relaxed">{item.text}</span>
    </li>
  ))}
</ol>

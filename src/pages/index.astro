---
import { getEntry } from "astro:content"
import Base from "../layouts/Base.astro"
import Hero from "../components/Hero.astro"
import WorkSection from "../components/WorkSection.astro"
import ExperienceList from "../components/ExperienceList.astro"
import Contact from "../components/Contact.astro"

const { contact, experience } = (await getEntry("resume", "resume"))!.data
---

<Base>
  <Hero github={contact.github} linkedin={contact.linkedin} />
  <main class="px-4 md:px-12 max-w-6xl mx-auto pt-32">
    <WorkSection />
    <ExperienceList experience={experience} />
    <Contact email={contact.email} />
  </main>
</Base>

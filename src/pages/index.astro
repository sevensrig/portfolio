---
import { getEntry } from "astro:content"
import Base from "../layouts/Base.astro"
import Hero from "../components/Hero.astro"
import WorkSection from "../components/WorkSection.astro"
import RoleList from "../components/RoleList.astro"
import Testimonials from "../components/Testimonials.astro"
import Contact from "../components/Contact.astro"

const { contact, experience, community, testimonials } = (await getEntry("resume", "resume"))!.data
---

<Base>
  <Hero github={contact.github} linkedin={contact.linkedin} />
  <main class="px-4 md:px-12 max-w-6xl mx-auto pt-32">
    <WorkSection />
    <RoleList id="experience" title="Experience" roles={experience}>
      <a id="resume" href="/resume.pdf" target="_blank" rel="noopener" class="mt-8 inline-block font-medium underline decoration-primary decoration-2 underline-offset-4">View full résumé ↗</a>
    </RoleList>
    <Testimonials testimonials={testimonials} />
    <RoleList id="community" title="Leadership and community" roles={community} />
    <Contact email={contact.email} name={contact.name} />
  </main>
</Base>

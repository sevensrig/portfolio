---
import Icon from "../../components/Icon.astro"
import { faGlobe } from "@fortawesome/free-solid-svg-icons"
import { faGithub } from "@fortawesome/free-brands-svg-icons"
// One page per project, like generateStaticParams + a dynamic route in Next.js.
// Layout: title → meta → hero media → TL;DR (the 30-second layer) → the story
// (the deep layer) → next project.
import { getCollection, render, type CollectionEntry } from "astro:content"
import Base from "../../layouts/Base.astro"
import ProjectMedia from "../../components/ProjectMedia.astro"
import * as story from "../../components/story"
import { yearRange } from "../../lib/format"

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order)
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }))
}

interface Props {
  project: CollectionEntry<"projects">
  next: CollectionEntry<"projects">
}
const { project, next } = Astro.props
const { title, tagline, period, role, status, stack, tldr, links, media } = project.data
const { Content } = await render(project)

const statusLabel = { shipped: "Shipped", active: "Active", archived: "Archived", abandoned: "Abandoned" }[status]
const facts = [
  ["Problem", tldr.problem],
  ["Built", tldr.built],
  ["Stack", stack.join(", ")],
  ["Outcome", tldr.outcome],
]
---

<Base title={title} description={tagline} og={project.id}>
  <main class="px-4 md:px-12 max-w-6xl mx-auto pt-16 pb-32">
    <a href="/#work" class="font-mono text-xs text-base-content/50 hover:text-base-content">← All work</a>

    <header class="mt-10">
      <h1 class="font-semibold leading-[0.98] tracking-[-0.04em] text-[clamp(2.4rem,6vw,5.5rem)]">
        {title}<span class="text-primary">.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg md:text-xl text-base-content/70">{tagline}</p>
      <div class="mt-6 flex flex-wrap items-baseline gap-x-6 gap-y-2">
        <p class="font-mono text-xs text-base-content/50">
          {yearRange(period.start, period.end)} · {role} · {statusLabel}
        </p>
        {links.demo && <a href={links.demo} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm font-medium"><Icon icon={faGlobe} /><span class="underline decoration-primary decoration-2 underline-offset-4">Live link ↗</span></a>}
        {links.github && <a href={links.github} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm font-medium"><Icon icon={faGithub} /><span class="underline decoration-primary decoration-2 underline-offset-4">Code ↗</span></a>}
      </div>
    </header>

    {
      media.loop ? (
        <story.Video src={media.loop.src} poster={media.loop.poster} loop class="mt-12" />
      ) : (
        <ProjectMedia src={media.hero} alt={title} aspect="wide" position={media.heroPosition} class="mt-12" />
      )
    }

    <section aria-label="Summary">
      <dl class="mt-12 grid md:grid-cols-2 border-t border-base-content">
        {facts.map(([label, text]) => (
          <div class="py-6 md:pr-12 border-b border-base-content/15">
            <dt class="font-mono text-xs uppercase tracking-widest text-base-content/50">{label}</dt>
            <dd class="mt-2 leading-relaxed">{text}</dd>
          </div>
        ))}
      </dl>
    </section>

    <article class="story mx-auto mt-24 max-w-2xl text-lg leading-relaxed">
      <Content components={story} />
    </article>

    {
      next.id !== project.id && (
        <a href={`/projects/${next.id}/`} class="group mt-32 block border-t border-base-content pt-8">
          <span class="font-mono text-xs uppercase tracking-widest text-base-content/50">Next project</span>
          <span class="mt-3 block text-3xl md:text-5xl font-semibold tracking-[-0.035em] group-hover:text-primary transition-colors">
            {next.data.title} →
          </span>
        </a>
      )
    }
  </main>
</Base>

<style>
  /* Minimal prose styles for the MDX story. :where() keeps them easy for
     the story components' own spacing to override. */
  :global(:where(.story) > * + *) { margin-top: 1.25em; }
  .story :global(h2) { margin-top: 2.5em; font-size: 1.75rem; line-height: 1.2; font-weight: 600; letter-spacing: -0.03em; }
  .story :global(h3) { margin-top: 2em; font-size: 1.25rem; font-weight: 600; }
  .story :global(a) { text-decoration: underline 2px var(--color-primary); text-underline-offset: 4px; }
  .story :global(ul) { list-style: disc; padding-left: 1.25em; }
  .story :global(ol:not(.not-prose)) { list-style: decimal; padding-left: 1.25em; }
  .story :global(li + li) { margin-top: 0.4em; }
  .story :global(code) { font-family: var(--font-mono); font-size: 0.85em; background: var(--color-base-200); padding: 0.1em 0.3em; }
  .story :global(pre) { font-family: var(--font-mono); font-size: 0.8rem; background: var(--color-base-200); border: 1px solid color-mix(in oklab, var(--color-base-content) 15%, transparent); padding: 1rem 1.25rem; overflow-x: auto; }
  .story :global(pre code) { background: none; padding: 0; }
  .story :global(table) { width: 100%; border-top: 1px solid var(--color-base-content); font-size: 1rem; font-variant-numeric: tabular-nums; }
  .story :global(th), .story :global(td) { padding: 0.6rem 0.75rem 0.6rem 0; text-align: left; border-bottom: 1px solid color-mix(in oklab, var(--color-base-content) 15%, transparent); }
  .story :global(th) { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 400; text-transform: uppercase; letter-spacing: 0.1em; color: color-mix(in oklab, var(--color-base-content) 50%, transparent); }
  .story :global(blockquote) { border-left: 2px solid var(--color-primary); padding-left: 1.25rem; color: color-mix(in oklab, var(--color-base-content) 75%, transparent); }
</style>
